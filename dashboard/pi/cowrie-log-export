#!/bin/sh
# Writes a tar.gz to stdout: recent Cowrie JSON logs plus captured text files (scripts),
# up to 256 KiB each and the newest 200. Binaries and recordings are never included.
# Runs as the cowrie user, via a forced SSH command.
set -eu
LOGS=/home/cowrie/cowrie/var/log/cowrie
SAMPLES=/home/cowrie/cowrie/var/lib/cowrie/downloads
logs=$(mktemp); texts=$(mktemp)
trap 'rm -f "$logs" "$texts"' EXIT
cd "$LOGS"
find . -maxdepth 1 -type f -name 'cowrie.json*' -mtime -14 -printf '%P\0' > "$logs"
cd "$SAMPLES"
find . -maxdepth 1 -type f -size -257k -regextype posix-extended -regex '\./[0-9a-f]{64}' -printf '%T@ %P\n' \
  | sort -rn | head -n 200 | cut -d' ' -f2 | while read -r f; do
      if grep -Iq '' "$f"; then printf '%s\0' "$f"; fi
    done > "$texts"
tar --warning=no-file-changed -czf - -C "$LOGS" --null -T "$logs" -C "$SAMPLES" --null -T "$texts" || [ $? -eq 1 ]
