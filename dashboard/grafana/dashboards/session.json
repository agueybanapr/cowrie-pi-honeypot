     "rawQuery": true,
     "rawSql": "SELECT s.session, s.started, s.protocol, s.src_ip, g.country, g.city, s.logged_in, s.username, s.password, s.failed_logins, s.commands, s.files, round(s.duration_s::numeric, 1) AS seconds FROM sessions s LEFT JOIN ip_geo g ON g.ip = s.src_ip WHERE s.session = ${session:sqlstring}",
