     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE eventid='cowrie.login.success') / nullif(count(*), 0), 1) FROM events WHERE (eventid='cowrie.login.success' OR eventid='cowrie.login.failed') AND $__timeFilter(ts)",
     "format": "table",
     "editorMode": "code"
    }
   ]
  },
