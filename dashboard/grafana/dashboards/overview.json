   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT coalesce(g.country, 'Unknown') AS country, count(*) AS connections, count(DISTINCT e.src_ip) AS ips FROM events e LEFT JOIN ip_geo g ON g.ip = e.src_ip WHERE e.eventid='cowrie.session.connect' AND $__timeFilter(e.ts) GROUP BY 1 ORDER BY 2 DESC LIMIT 25",
     "format": "table",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
