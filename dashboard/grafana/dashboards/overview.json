  {
   "id": 8,
   "type": "stat",
   "title": "Login success rate",
   "description": "Cowrie accepts most passwords on purpose, so a high rate is normal for a honeypot.",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 5,
    "h": 3
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "#73bf69"
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
