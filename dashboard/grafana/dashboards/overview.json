   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT count(*) FROM events WHERE eventid='cowrie.session.connect' AND $__timeFilter(ts)",
     "format": "table",
     "editorMode": "code"
