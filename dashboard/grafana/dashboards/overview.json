     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT min(ts) AS first_seen, shasum AS sha256, count(*) AS times, max(coalesce(url, filename)) AS source FROM events WHERE eventid IN ('cowrie.session.file_download','cowrie.session.file_upload') AND shasum IS NOT NULL AND $__timeFilter(ts) GROUP BY 2 ORDER BY 1 DESC LIMIT 50",
