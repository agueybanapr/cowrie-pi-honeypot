  {
   "id": 7,
   "type": "timeseries",
   "title": "Connections over time, by protocol",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "honeypot-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroup(ts, $__interval, 0) AS time, protocol AS metric, count(*) AS value FROM events WHERE eventid='cowrie.session.connect' AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 25,
      "stacking": {
       "mode": "normal"
      },
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Logins and commands over time",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "honeypot-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT $__timeGroup(ts, $__interval, 0) AS time, replace(eventid, 'cowrie.', '') AS metric, count(*) AS value FROM events WHERE eventid IN ('cowrie.login.success','cowrie.login.failed','cowrie.command.input') AND $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 25,
      "stacking": {
       "mode": "normal"
      },
      "spanNulls": false
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "geomap",
   "title": "Where connections come from",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "honeypot-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 14,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT g.lat, g.lon, g.city, g.country, count(*) AS connections, count(DISTINCT e.src_ip) AS ips FROM events e JOIN ip_geo g ON g.ip = e.src_ip WHERE e.eventid='cowrie.session.connect' AND g.lat IS NOT NULL AND $__timeFilter(e.ts) GROUP BY 1, 2, 3, 4",
     "format": "table",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "view": {
     "id": "zero",
     "lat": 20,
     "lon": 0,
     "zoom": 1
    },
    "controls": {
     "showZoom": true,
     "mouseWheelZoom": true
    },
    "tooltip": {
     "mode": "details"
    },
    "basemap": {
     "type": "osm-standard",
     "name": "OpenStreetMap"
    },
    "layers": [
     {
      "type": "markers",
      "name": "Attack sources",
      "tooltip": true,
      "location": {
       "mode": "coords",
       "latitude": "lat",
       "longitude": "lon"
      },
      "config": {
       "showLegend": false,
       "style": {
        "color": {
         "fixed": "red"
        },
        "opacity": 0.6,
        "symbol": {
         "fixed": "img/icons/marker/circle.svg",
         "mode": "fixed"
        },
        "size": {
         "field": "connections",
         "min": 4,
         "max": 24,
         "fixed": 6
        }
       }
      }
     }
    ]
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Top countries",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
