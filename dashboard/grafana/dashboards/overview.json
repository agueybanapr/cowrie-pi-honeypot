  {
   "id": 15,
   "type": "table",
   "title": "Captured files",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "honeypot-pg"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT min(ts) AS first_seen, shasum, count(*) AS times, max(coalesce(url, filename)) AS source FROM events WHERE eventid IN ('cowrie.session.file_download','cowrie.session.file_upload') AND shasum IS NOT NULL AND $__timeFilter(ts) GROUP BY 2 ORDER BY 1 DESC LIMIT 50",
     "format": "table",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 16,
   "type": "table",
   "title": "Sessions: click an ID for details",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "honeypot-pg"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "honeypot-pg"
     },
     "rawQuery": true,
     "rawSql": "SELECT s.started, s.session, s.protocol, s.src_ip, coalesce(g.country, 'Unknown') AS country, s.logged_in, s.username, s.password, s.failed_logins, s.commands, s.files, round(s.duration_s::numeric, 1) AS seconds FROM sessions s LEFT JOIN ip_geo g ON g.ip = s.src_ip WHERE $__timeFilter(s.started) ORDER BY s.logged_in DESC, s.started DESC LIMIT 200",
     "format": "table",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "session"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open session",
          "url": "/d/honeypot-session/session?var-session=${__value.raw}&from=now-90d&to=now"
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
