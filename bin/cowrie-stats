#!/usr/bin/env bash
# cowrie-stats - quick summaries and session replay for a local Cowrie honeypot.
#
# Runs itself as the cowrie user (via sudo), so it never executes Cowrie's
# Python environment as root. Attacker-supplied text in listings has control
# characters replaced by '?', so log contents cannot drive your terminal.
# Replays keep colours and cursor movement but drop sequences that act on your
# terminal (clipboard, title, hyperlinks, reports); --raw replays the bytes as-is.

set -euo pipefail

COWRIE_USER="${COWRIE_USER:-cowrie}"
COWRIE_HOME="${COWRIE_HOME:-/home/cowrie/cowrie}"
LOG_DIR="$COWRIE_HOME/var/log/cowrie"
PLAYLOG="$COWRIE_HOME/cowrie-env/bin/playlog"
TOP=10

usage() {
  cat <<'EOF'
Usage:
  cowrie-stats                   summary: totals, top IPs, credentials, commands, files
  cowrie-stats summary [--hours H] [--top N]
                                 summary of the last H hours only, with N entries per list
  cowrie-stats report [--hours H] [--top N]
                                 short phone-friendly report, used for notifications
  cowrie-stats sessions [N]      list the N most recent logged-in sessions (default 20)
  cowrie-stats sessions --files [N]
                                 only sessions that downloaded or uploaded a file
  cowrie-stats replay [--raw] [#|ID]
                                 replay a session like a video (asks which one if omitted);
                                 --raw keeps escape sequences that act on your terminal
  cowrie-stats show <#|ID>       print one session's commands and files as text
  cowrie-stats files             captured files: how they arrived, SHA-256, sessions to replay

# is the number shown by "sessions" (1 = newest); ID is Cowrie's session id.
Extra arguments after "replay #" are passed to playlog.
EOF
}

die() { printf 'cowrie-stats: %s\n' "$*" >&2; exit 1; }

case "${1:-summary}" in
  summary|report|sessions|replay|show|files|downloads) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [ "$(id -un)" != "$COWRIE_USER" ]; then
  exec sudo -u "$COWRIE_USER" -- "$(readlink -f "$0")" "$@"
fi

command -v jq >/dev/null || die "jq is not installed (sudo apt install -y jq)"
cd "$COWRIE_HOME" 2>/dev/null || die "cannot enter $COWRIE_HOME"
[ -d "$LOG_DIR" ] || die "no log directory at $LOG_DIR"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
EV="$WORK/events.jsonl"
LOADED=0
SINCE=""   # Local-time cutoff "YYYY-MM-DDTHH:MM:SS"; empty means all retained logs

# Shared jq helpers: strip control characters and shorten long values. defang turns
# URLs and domains into text a phone won't make tappable (hxxp://evil[.]com).
DEFS='def clean: tostring | gsub("[[:cntrl:]]"; "?");
def trunc($n): if length > $n then .[0:$n-1] + "~" else . end;
def defang: gsub("http"; "hxxp"; "i") | gsub("ftp"; "fxp"; "i") | gsub("\\."; "[.]");'

# Read current and rotated JSON logs once, keeping only the events used below.
# Malformed lines are skipped rather than aborting the report.
load_events() {
  [ "$LOADED" = 1 ] && return 0
  find "$LOG_DIR" -maxdepth 1 -type f -name 'cowrie.json*' -print0 \
    | xargs -0 -r zcat -f -- \
    | LC_ALL=C grep -E '"eventid": ?"cowrie\.(session\.(connect|closed|file_download|file_upload)|login\.(success|failed)|command\.input|log\.closed|client\.version)"' \
    | jq -cR --arg since "$SINCE" 'fromjson? | select(type == "object" and (.eventid | type) == "string")
        | select($since == "" or ((.timestamp // "") >= $since))
        | select(.eventid | test("^cowrie\\.(session\\.(connect|closed|file_download|file_upload)|login\\.(success|failed)|command\\.input|log\\.closed|client\\.version)$"))' \
    > "$EV" || true
  LOADED=1
}

top_list() { # title, jq filter producing one string per event
  printf '\n== %s\n' "$1"
  { jq -r "$DEFS $2" "$EV" | sort | uniq -c | sort -rn | awk -v n="$TOP" 'NR <= n' \
      | awk '{ print } END { if (NR == 0) print "      (none)" }'; } || true
}

summary() {
  local hours=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="${2:-}"; shift 2 || die "--hours needs a number" ;;
      --top)   TOP="${2:-}";   shift 2 || die "--top needs a number" ;;
      *) die "unknown summary option: $1" ;;
    esac
  done
  case "$TOP" in ''|0|*[!0-9]*) die "--top must be a positive number" ;; esac
  if [ -n "$hours" ]; then
    case "$hours" in 0|*[!0-9]*) die "--hours must be a positive number" ;; esac
    SINCE="$(date -d "-$hours hours" +%Y-%m-%dT%H:%M:%S)"
  fi
  load_events
  if [ ! -s "$EV" ]; then
    if [ -n "$SINCE" ]; then
      echo "No Cowrie activity in the last $hours hours (since $SINCE local)."
    else
      echo "No Cowrie events in $LOG_DIR yet."
    fi
    return 0
  fi
  local first last ips
  first="$(jq -r '.timestamp // empty' "$EV" | sort | awk 'NR == 1')" || true
  last="$(jq -r '.timestamp // empty' "$EV" | sort | tail -n 1)" || true
  ips="$(jq -r 'select(.eventid == "cowrie.session.connect") | .src_ip // empty' "$EV" | sort -u | wc -l)"

  if [ -n "$SINCE" ]; then
    printf 'Cowrie activity, last %s hours (since %s local)\n\n' "$hours" "$SINCE"
  else
    printf 'Cowrie activity %s -> %s (local time)\n\n' "${first:0:19}" "${last:0:19}"
  fi
  jq -rn '(reduce inputs as $e ({}; .[$e.eventid] += 1)) as $c
    | [ ["Connections",       "cowrie.session.connect"],
        ["Failed logins",     "cowrie.login.failed"],
        ["Successful logins", "cowrie.login.success"],
        ["Commands run",      "cowrie.command.input"],
        ["Files fetched by attacker commands", "cowrie.session.file_download"],
        ["Files pushed by attackers (SCP/SFTP)", "cowrie.session.file_upload"] ]
    | .[] | "  \(.[0]): \($c[.[1]] // 0)"' "$EV"
  printf '  Unique source IPs: %s\n' "$ips"

  printf '\n== Connections per day (last 14 days)\n'
  { jq -r 'select(.eventid == "cowrie.session.connect") | .timestamp[0:10]' "$EV" \
      | sort | uniq -c | tail -n 14; } || true

  top_list "Top source IPs" 'select(.eventid == "cowrie.session.connect") | .src_ip // "?" | clean'
  top_list "Top username:password pairs" \
    'select(.eventid | test("^cowrie\\.login\\.")) | "\(.username // "" | clean):\(.password // "" | clean)" | trunc(70)'
  top_list "Top commands" 'select(.eventid == "cowrie.command.input") | .input // "" | clean | trunc(110)'
  top_list "Top SSH client versions" 'select(.eventid == "cowrie.client.version") | .version // "?" | clean | trunc(80)'
  top_list "Top download URLs" 'select(.eventid == "cowrie.session.file_download") | .url // "?" | clean | trunc(110)'

  printf '\nMore: cowrie-stats sessions | replay [#] | show <#> | files | --help\n'
}

# Phone-friendly report for notifications. The first line is the headline; the rest is
# plain text. It is not Markdown, so attacker-written text cannot become links.
report() {
  local hours=24
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="${2:-}"; shift 2 || die "--hours needs a number" ;;
      --top)   TOP="${2:-}";   shift 2 || die "--top needs a number" ;;
      *) die "unknown report option: $1" ;;
    esac
  done
  case "$TOP" in ''|0|*[!0-9]*) die "--top must be a positive number" ;; esac
  case "$hours" in ''|0|*[!0-9]*) die "--hours must be a positive number" ;; esac
  SINCE="$(date -d "-$hours hours" +%Y-%m-%dT%H:%M:%S)"
  load_events
  jq -rn --argjson top "$TOP" --argjson hours "$hours" "$DEFS"'
    def commas: tostring | gsub("(?<d>[0-9])(?=([0-9]{3})+$)"; "\(.d),");
    def plural($n; $word): "\($n | commas) \($word)\(if $n == 1 then "" else "s" end)";
    def ranked: group_by(.) | map({v: .[0], c: length}) | sort_by(-.c) | .[0:$top]
      | if length == 0 then ["   none"] else map("   \(.c | commas)  \(.v)") end;
    def only($id): map(select(.eventid == $id));
    [inputs] as $e
    | ($e | only("cowrie.session.connect")) as $conn
    | ($e | only("cowrie.command.input")) as $cmds
    | ($e | map(select(.eventid | test("^cowrie\\.login\\.")))) as $logins
    | ($conn | map(.src_ip) | unique | length) as $ips
    | ($e | map(select((.eventid | test("^cowrie\\.session\\.file_")) and .shasum
                       and (.shasum | startswith("e3b0c44298fc1c149afbf4c8996fb924") | not)))
        | unique_by(.shasum) | sort_by(.timestamp) | reverse) as $files
    | "Honeypot: \(plural($conn | length; "connection")), \(plural($ips; "IP")), \(plural($files | length; "file"))",
      "Last \($hours) hours",
      "",
      "🔌 Connections: \($conn | length | commas) from \($ips | commas) IPs",
      "🔑 Logins: \($logins | only("cowrie.login.success") | length | commas) accepted, \($logins | only("cowrie.login.failed") | length | commas) rejected",
      "⌨️ Commands: \($cmds | length | commas)",
      "📦 Files captured: \($files | length | commas)",
      "",
      "🌍 Top source IPs",
      ($conn | map(.src_ip // "?" | clean) | ranked)[],
      "",
      "🔐 Top logins tried",
      ($logins | map("\(.username // "" | clean):\(.password // "" | clean)" | trunc(40)) | ranked)[],
      "",
      "💻 Top commands",
      ($cmds | map(.input // "" | clean | defang | trunc(50)) | ranked)[],
      (if ($files | length) > 0 then
         "",
         "🚩 Files",
         ($files[0:$top][] | "   \(.shasum[0:12])  \(.url // .filename // "source not logged" | clean | defang | trunc(40))")
       else empty end)' "$EV"
}

# One TSV row per logged-in session, newest first:
# n start proto ip user:pass cmds files duration replay id ttylog
session_rows() {
  load_events
  jq -rn "$DEFS"'
    reduce (inputs | select((.session // "") != "")) as $e ({};
      .[$e.session] |= (
        ((. // {id: $e.session, cmds: 0, files: 0}) +
          (if   $e.eventid == "cowrie.session.connect" then {start: $e.timestamp, ip: $e.src_ip, proto: $e.protocol}
           elif $e.eventid == "cowrie.login.success"   then {user: $e.username, pass: $e.password}
           elif $e.eventid == "cowrie.log.closed"      then {tty: $e.ttylog}
           elif $e.eventid == "cowrie.session.closed"  then
             {ms: ($e.duration_ms // ((($e.duration // 0) | (tonumber? // 0)) * 1000))}
           else {} end))
        | if $e.eventid == "cowrie.command.input" then .cmds += 1 else . end
        | if ($e.eventid | test("^cowrie\\.session\\.file_")) then .files += 1 else . end))
    | [.[] | select(.user != null)] | sort_by(.start // "") | reverse
    | to_entries[] | .key as $i | .value
    | [ ($i + 1),
        ((.start // "?") | sub("T"; " ") | .[0:19]),
        (.proto // "?" | clean),
        (.ip // "?" | clean),
        ("\(.user | clean):\(.pass // "" | clean)" | trunc(28)),
        .cmds, .files,
        (if .ms then "\(.ms / 1000 | floor)s" else "?" end),
        (if .tty then "yes" else "no" end),
        .id,
        (.tty // "" | clean) ]
    | map(tostring) | @tsv' "$EV"
}

list_sessions() {
  local only_files=0 rows
  if [ "${1:-}" = "--files" ]; then only_files=1; shift; fi
  local limit="${1:-20}"
  case "$limit" in ''|*[!0-9]*) die "session count must be a number" ;; esac
  rows="$(session_rows)"
  if [ -z "$rows" ]; then
    echo "No logged-in sessions yet."
    return 1
  fi
  if [ "$only_files" = 1 ]; then
    rows="$(printf '%s\n' "$rows" | awk -F'\t' '$7 > 0')"
    if [ -z "$rows" ]; then
      echo "No logged-in sessions with files yet."
      return 1
    fi
  fi
  { printf '%s\n' "$rows" | awk -v n="$limit" 'NR <= n' | awk -F'\t' '
      BEGIN { f = "%4s  %-19s  %-6s  %-15s  %-28s  %4s  %5s  %6s  %s\n"
              printf f, "#", "START (local)", "PROTO", "SOURCE IP", "USER:PASS", "CMDS", "FILES", "TIME", "REPLAY" }
      { printf f, $1, $2, $3, $4, $5, $6, $7, $8, $9 }'; } || true
}

find_session() { # number (1-6 digits) or session id -> TSV row
  local rows
  rows="$(session_rows)"
  if [[ "$1" =~ ^[0-9]{1,6}$ ]]; then
    printf '%s\n' "$rows" | awk -F'\t' -v n="$1" '$1 == n { print }'
  else
    printf '%s\n' "$rows" | awk -F'\t' -v id="$1" '$10 == id { print }'
  fi
}

print_header() {
  local n start proto ip cred cmds files dur tty id ttypath
  IFS=$'\t' read -r n start proto ip cred cmds files dur tty id ttypath <<<"$1"
  printf 'Session #%s (%s)\n  %s from %s at %s local, lasted %s, logged in as %s\n  %s commands, %s files\n' \
    "$n" "$id" "$proto" "$ip" "$start" "$dur" "$cred" "$cmds" "$files"
}

show_session() {
  [ -n "${1:-}" ] || die "usage: cowrie-stats show <#|SESSION_ID>"
  local row id
  row="$(find_session "$1")"
  [ -n "$row" ] || die "no logged-in session matches '$1' (see: cowrie-stats sessions)"
  print_header "$row"
  echo
  id="$(cut -f10 <<<"$row")"
  jq -r --arg id "$id" "$DEFS"'
    select(.session == $id)
    | if .eventid == "cowrie.command.input" then
        "  \(.timestamp[11:19])  $ \(.input // "" | clean)"
      elif (.eventid | test("^cowrie\\.session\\.file_")) then
        "  \(.timestamp[11:19])  [\(if .eventid | test("upload") then "file pushed" else "file fetched" end)] \(.shasum // "?")  \(.url // .filename // "" | clean)"
      else empty end' "$EV"
}

# Pass a recording through, minus the escape sequences that act on your terminal instead
# of drawing on it: OSC/DCS/APC/PM/SOS strings (clipboard writes, window titles, hyperlinks,
# terminal-specific commands) and requests that make the terminal type a reply (window and
# title reports, status and attribute queries). Colours and cursor movement are kept, so the
# replay still looks right. Works on a stream, holding back a sequence split across reads.
tty_filter() {
  perl -e '
    use strict; use warnings;
    binmode STDIN; binmode STDOUT; $| = 1;
    my $str = qr/(?:\e[\]PX^_]|\xc2[\x90\x98\x9d\x9e\x9f])/;      # starts a string sequence
    my $body = qr/(?:(?!\xc2\x9c)[^\a\e])*/;                      # its contents
    my $csi = qr/(?:\e\[|\xc2\x9b)/;
    my $buf = "";
    while (sysread(STDIN, my $in, 65536)) {
      $buf .= $in;
      # A string sequence ends at BEL or ST; any other ESC also ends it in most terminals.
      $buf =~ s/$str$body(?:\a|\e\\|\xc2\x9c|(?=\e))//g;
      $buf =~ s/$csi[0-9;?>=]*[tnc]//g;
      my $hold = "";
      if ($buf =~ s/($str$body|$csi[0-9;?>=]*|\e|\xc2)\z//) {
        $hold = $1;
        $hold = "" if length($hold) > 65536;    # an endless string sequence is dropped
      }
      print $buf;
      $buf = $hold;
    }
    # Anything left is an unfinished sequence: drop it.
  '
}

replay() {
  local raw=0 sel row ttypath
  if [ "${1:-}" = --raw ]; then raw=1; shift; fi
  sel="${1:-}"
  if [ -z "$sel" ]; then
    list_sessions 20 || return 0
    read -rp $'\nReplay which #? ' sel
    [ -n "$sel" ] || return 0
  else
    shift
  fi
  row="$(find_session "$sel")"
  [ -n "$row" ] || die "no logged-in session matches '$sel' (see: cowrie-stats sessions)"
  ttypath="$(cut -f11 <<<"$row")"
  if [ -z "$ttypath" ]; then
    echo "Session $sel has no terminal recording. Its commands:"
    echo
    show_session "$sel"
    return 0
  fi
  case "$ttypath" in /*) ;; *) ttypath="$COWRIE_HOME/$ttypath" ;; esac
  [ -f "$ttypath" ] || die "recording not found: $ttypath"
  print_header "$row"
  printf '  Replaying (Ctrl+C to stop)...\n\n'
  local play=("$COWRIE_HOME/cowrie-env/bin/python" -m cowrie.scripts.playlog)
  [ -x "$PLAYLOG" ] && play=("$PLAYLOG")
  if [ "$raw" = 1 ]; then
    "${play[@]}" "$@" "$ttypath"
  else
    "${play[@]}" "$@" "$ttypath" | tty_filter
  fi
}

# Each captured file, newest first, with the sessions that delivered it. A file is
# "fetched" when an attacker's command made the honeypot download it, and "pushed"
# when the attacker sent it directly. Both are stored the same way, by SHA-256.
list_files() {
  local out
  load_events
  out="$(jq -rn "$DEFS"'
    def when: .[5:19] | sub("T"; " ");
    [inputs | select((.eventid | test("^cowrie\\.session\\.file_")) and .shasum)]
    | group_by(.shasum)
    | map({sha: .[0].shasum, first: (map(.timestamp) | min), out: (.[0].outfile // "?" | if contains("/") then . else "var/lib/cowrie/downloads/" + . end),
           seen: (unique_by([.session, .eventid]) | sort_by(.timestamp) | reverse)})
    | sort_by(.first) | reverse | .[]
    | "sha256 \(.sha)\(if .sha | startswith("e3b0c44298fc1c149afbf4c8996fb924") then "  (EMPTY FILE: nothing to analyze)" else "" end)\n"
      + "  saved: \(.out | clean)\n"
      + (.seen[0:5] | map("  \(.timestamp | when)  \(if .eventid | test("upload") then "pushed " else "fetched" end)  session \(.session // "?" | clean)  from \(.src_ip // "?" | clean)  \(.url // .filename // "(source not logged)" | clean | trunc(60))") | join("\n"))
      + (if (.seen | length) > 5 then "\n  ... and \((.seen | length) - 5) more sessions" else "" end) + "\n"' "$EV")"
  if [ -z "$out" ]; then
    echo "No files captured yet."
  else
    printf '%s\n' "$out"
    echo "fetched = an attacker's command made the honeypot download it; pushed = sent directly (SCP/SFTP)."
    echo "Watch a session: cowrie-stats replay <session>   Commands as text: cowrie-stats show <session>"
  fi
}

cmd="${1:-summary}"
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  summary)        summary "$@" ;;
  report)         report "$@" ;;
  sessions)       list_sessions "$@" ;;
  replay)         replay "$@" ;;
  show)           show_session "${1:-}" ;;
  files|downloads) list_files ;;
esac
