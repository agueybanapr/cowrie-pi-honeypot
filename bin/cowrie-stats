#!/usr/bin/env bash
# cowrie-stats - quick summaries and session replay for a local Cowrie honeypot.
#
# Runs itself as the cowrie user (via sudo), so it never executes Cowrie's
# Python environment as root. Attacker-supplied text in listings has control
# characters replaced by '?', so log contents cannot drive your terminal.
# Replays show the recorded session output as-is; that is what a replay is.

set -euo pipefail

COWRIE_USER="${COWRIE_USER:-cowrie}"
COWRIE_HOME="${COWRIE_HOME:-/home/cowrie/cowrie}"
LOG_DIR="$COWRIE_HOME/var/log/cowrie"
PLAYLOG="$COWRIE_HOME/cowrie-env/bin/playlog"
TOP=10

usage() {
  cat <<'EOF'
Usage:
  cowrie-stats                   summary: totals, top IPs, credentials, commands, downloads
  cowrie-stats summary [--hours H] [--top N]
                                 summary of the last H hours only, with N entries per list
  cowrie-stats sessions [N]      list the N most recent logged-in sessions (default 20)
  cowrie-stats replay [#|ID]     replay a session like a video (asks which one if omitted)
  cowrie-stats show <#|ID>       print one session's commands and files as text
  cowrie-stats downloads         list captured files with SHA-256 and source URLs

# is the number shown by "sessions" (1 = newest); ID is Cowrie's session id.
Extra arguments after "replay #" are passed to playlog.
EOF
}

die() { printf 'cowrie-stats: %s\n' "$*" >&2; exit 1; }

case "${1:-summary}" in
  summary|sessions|replay|show|downloads) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

if [ "$(id -un)" != "$COWRIE_USER" ]; then
  exec sudo -u "$COWRIE_USER" -- "$(readlink -f "$0")" "$@"
fi

command -v jq >/dev/null || die "jq is not installed (sudo apt install -y jq)"
cd "$COWRIE_HOME" 2>/dev/null || die "cannot enter $COWRIE_HOME"
[ -d "$LOG_DIR" ] || die "no log directory at $LOG_DIR"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
EV="$WORK/events.jsonl"
LOADED=0
SINCE=""   # UTC cutoff "YYYY-MM-DDTHH:MM:SS"; empty means all retained logs

# Shared jq helpers: strip control characters and shorten long values.
DEFS='def clean: tostring | gsub("[[:cntrl:]]"; "?");
def trunc($n): if length > $n then .[0:$n-1] + "~" else . end;'

# Read current and rotated JSON logs once, keeping only the events used below.
# Malformed lines are skipped rather than aborting the report.
load_events() {
  [ "$LOADED" = 1 ] && return 0
  find "$LOG_DIR" -maxdepth 1 -type f -name 'cowrie.json*' -print0 \
    | xargs -0 -r zcat -f -- \
    | jq -cR --arg since "$SINCE" 'fromjson? | select(type == "object" and (.eventid | type) == "string")
        | select($since == "" or ((.timestamp // "") >= $since))
        | select(.eventid | test("^cowrie\\.(session\\.(connect|closed|file_download|file_upload)|login\\.(success|failed)|command\\.input|log\\.closed|client\\.version)$"))' \
    > "$EV" || true
  LOADED=1
}

top_list() { # title, jq filter producing one string per event
  printf '\n== %s\n' "$1"
  { jq -r "$DEFS $2" "$EV" | sort | uniq -c | sort -rn | head -n "$TOP" \
      | awk '{ print } END { if (NR == 0) print "      (none)" }'; } || true
}

summary() {
  local hours=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --hours) hours="${2:-}"; shift 2 || die "--hours needs a number" ;;
      --top)   TOP="${2:-}";   shift 2 || die "--top needs a number" ;;
      *) die "unknown summary option: $1" ;;
    esac
  done
  case "$TOP" in ''|0|*[!0-9]*) die "--top must be a positive number" ;; esac
  if [ -n "$hours" ]; then
    case "$hours" in 0|*[!0-9]*) die "--hours must be a positive number" ;; esac
    SINCE="$(date -u -d "-$hours hours" +%Y-%m-%dT%H:%M:%S)"
  fi
  load_events
  if [ ! -s "$EV" ]; then
    if [ -n "$SINCE" ]; then
      echo "No Cowrie activity in the last $hours hours (since $SINCE UTC)."
    else
      echo "No Cowrie events in $LOG_DIR yet."
    fi
    return 0
  fi
  local first last ips
  first="$(jq -r '.timestamp // empty' "$EV" | sort | head -n 1)" || true
  last="$(jq -r '.timestamp // empty' "$EV" | sort | tail -n 1)" || true
  ips="$(jq -r 'select(.eventid == "cowrie.session.connect") | .src_ip // empty' "$EV" | sort -u | wc -l)"

  if [ -n "$SINCE" ]; then
    printf 'Cowrie activity, last %s hours (since %s UTC)\n\n' "$hours" "$SINCE"
  else
    printf 'Cowrie activity %s -> %s (UTC)\n\n' "${first:0:19}" "${last:0:19}"
  fi
  jq -rn '(reduce inputs as $e ({}; .[$e.eventid] += 1)) as $c
    | [ ["Connections",       "cowrie.session.connect"],
        ["Failed logins",     "cowrie.login.failed"],
        ["Successful logins", "cowrie.login.success"],
        ["Commands run",      "cowrie.command.input"],
        ["Files downloaded",  "cowrie.session.file_download"],
        ["Files uploaded",    "cowrie.session.file_upload"] ]
    | .[] | "  \(.[0]): \($c[.[1]] // 0)"' "$EV"
  printf '  Unique source IPs: %s\n' "$ips"

  printf '\n== Connections per day (last 14 days)\n'
  { jq -r 'select(.eventid == "cowrie.session.connect") | .timestamp[0:10]' "$EV" \
      | sort | uniq -c | tail -n 14; } || true

  top_list "Top source IPs" 'select(.eventid == "cowrie.session.connect") | .src_ip // "?" | clean'
  top_list "Top username:password pairs" \
    'select(.eventid | test("^cowrie\\.login\\.")) | "\(.username // "" | clean):\(.password // "" | clean)" | trunc(70)'
  top_list "Top commands" 'select(.eventid == "cowrie.command.input") | .input // "" | clean | trunc(110)'
  top_list "Top SSH client versions" 'select(.eventid == "cowrie.client.version") | .version // "?" | clean | trunc(80)'
  top_list "Top download URLs" 'select(.eventid == "cowrie.session.file_download") | .url // "?" | clean | trunc(110)'

  printf '\nMore: cowrie-stats sessions | replay [#] | show <#> | downloads | --help\n'
}

# One TSV row per logged-in session, newest first:
# n start proto ip user:pass cmds files duration replay id ttylog
session_rows() {
  load_events
  jq -rn "$DEFS"'
    reduce (inputs | select((.session // "") != "")) as $e ({};
      .[$e.session] |= (
        ((. // {id: $e.session, cmds: 0, files: 0}) +
          (if   $e.eventid == "cowrie.session.connect" then {start: $e.timestamp, ip: $e.src_ip, proto: $e.protocol}
           elif $e.eventid == "cowrie.login.success"   then {user: $e.username, pass: $e.password}
           elif $e.eventid == "cowrie.log.closed"      then {tty: $e.ttylog}
           elif $e.eventid == "cowrie.session.closed"  then
             {ms: ($e.duration_ms // ((($e.duration // 0) | (tonumber? // 0)) * 1000))}
           else {} end))
        | if $e.eventid == "cowrie.command.input" then .cmds += 1 else . end
        | if ($e.eventid | test("^cowrie\\.session\\.file_")) then .files += 1 else . end))
    | [.[] | select(.user != null)] | sort_by(.start // "") | reverse
    | to_entries[] | .key as $i | .value
    | [ ($i + 1),
        ((.start // "?") | sub("T"; " ") | .[0:19]),
        (.proto // "?" | clean),
        (.ip // "?" | clean),
        ("\(.user | clean):\(.pass // "" | clean)" | trunc(28)),
        .cmds, .files,
        (if .ms then "\(.ms / 1000 | floor)s" else "?" end),
        (if .tty then "yes" else "no" end),
        .id,
        (.tty // "" | clean) ]
    | map(tostring) | @tsv' "$EV"
}

list_sessions() {
  local limit="${1:-20}" rows
  case "$limit" in ''|*[!0-9]*) die "session count must be a number" ;; esac
  rows="$(session_rows)"
  if [ -z "$rows" ]; then
    echo "No logged-in sessions yet."
    return 1
  fi
  { printf '%s\n' "$rows" | head -n "$limit" | awk -F'\t' '
      BEGIN { f = "%4s  %-19s  %-6s  %-15s  %-28s  %4s  %5s  %6s  %s\n"
              printf f, "#", "START (UTC)", "PROTO", "SOURCE IP", "USER:PASS", "CMDS", "FILES", "TIME", "REPLAY" }
      { printf f, $1, $2, $3, $4, $5, $6, $7, $8, $9 }'; } || true
}

find_session() { # number (1-6 digits) or session id -> TSV row
  local rows
  rows="$(session_rows)"
  if [[ "$1" =~ ^[0-9]{1,6}$ ]]; then
    printf '%s\n' "$rows" | awk -F'\t' -v n="$1" '$1 == n { print; exit }'
  else
    printf '%s\n' "$rows" | awk -F'\t' -v id="$1" '$10 == id { print; exit }'
  fi
}

print_header() {
  local n start proto ip cred cmds files dur tty id ttypath
  IFS=$'\t' read -r n start proto ip cred cmds files dur tty id ttypath <<<"$1"
  printf 'Session #%s (%s)\n  %s from %s at %s UTC, lasted %s, logged in as %s\n  %s commands, %s files\n' \
    "$n" "$id" "$proto" "$ip" "$start" "$dur" "$cred" "$cmds" "$files"
}

show_session() {
  [ -n "${1:-}" ] || die "usage: cowrie-stats show <#|SESSION_ID>"
  local row id
  row="$(find_session "$1")"
  [ -n "$row" ] || die "no logged-in session matches '$1' (see: cowrie-stats sessions)"
  print_header "$row"
  echo
  id="$(cut -f10 <<<"$row")"
  jq -r --arg id "$id" "$DEFS"'
    select(.session == $id)
    | if .eventid == "cowrie.command.input" then
        "  \(.timestamp[11:19])  $ \(.input // "" | clean)"
      elif (.eventid | test("^cowrie\\.session\\.file_")) then
        "  \(.timestamp[11:19])  [file] \(.shasum // "?")  \(.url // .filename // "" | clean)"
      else empty end' "$EV"
}

replay() {
  local sel="${1:-}" row ttypath
  if [ -z "$sel" ]; then
    list_sessions 20 || return 0
    read -rp $'\nReplay which #? ' sel
    [ -n "$sel" ] || return 0
  else
    shift
  fi
  row="$(find_session "$sel")"
  [ -n "$row" ] || die "no logged-in session matches '$sel' (see: cowrie-stats sessions)"
  ttypath="$(cut -f11 <<<"$row")"
  if [ -z "$ttypath" ]; then
    echo "Session $sel has no terminal recording. Its commands:"
    echo
    show_session "$sel"
    return 0
  fi
  case "$ttypath" in /*) ;; *) ttypath="$COWRIE_HOME/$ttypath" ;; esac
  [ -f "$ttypath" ] || die "recording not found: $ttypath"
  print_header "$row"
  printf '  Replaying (Ctrl+C to stop)...\n\n'
  if [ -x "$PLAYLOG" ]; then
    "$PLAYLOG" "$@" "$ttypath"
  else
    "$COWRIE_HOME/cowrie-env/bin/python" -m cowrie.scripts.playlog "$@" "$ttypath"
  fi
}

downloads() {
  local out
  load_events
  out="$(jq -rn "$DEFS"'
    [inputs | select((.eventid | test("^cowrie\\.session\\.file_")) and .shasum)]
    | group_by(.shasum)
    | map({sha: .[0].shasum, n: length, first: (map(.timestamp) | min),
           out: (.[0].outfile // "?"), srcs: (map(.url // .filename // "upload") | unique)})
    | sort_by(.first) | reverse | .[]
    | "\(.first[0:19] | sub("T"; " "))  seen \(.n)x  sha256 \(.sha)\n    saved: \(.out | clean)\n"
      + (.srcs[0:3] | map("    from:  " + (clean | trunc(110))) | join("\n")) + "\n"' "$EV")"
  if [ -z "$out" ]; then echo "No files captured yet."; else printf '%s\n' "$out"; fi
}

cmd="${1:-summary}"
if [ $# -gt 0 ]; then shift; fi
case "$cmd" in
  summary)        summary "$@" ;;
  sessions)       list_sessions "${1:-20}" ;;
  replay)         replay "$@" ;;
  show)           show_session "${1:-}" ;;
  downloads)      downloads ;;
esac
